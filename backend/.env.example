# Copy to .env for local development. Never commit the real .env file.

# Comma-separated list of frontend URLs allowed to call this API.
# Production example: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# Where the SQLite file lives. On Render use the persistent disk path: /var/data/documents.db
DATABASE_PATH=./data/documents.db

# Below this confidence (0-1) a document is shown as "Needs Manual Review".
CONFIDENCE_THRESHOLD=0.45

MAX_UPLOAD_MB=10
MAX_FILES_PER_REQUEST=20
